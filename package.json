{
  "name": "web-codex-orchestrator",
  "version": "0.3.0",
  "private": true,
  "description": "A durable, security-focused CLI for orchestrating Web-authored code changes through verification, review, and Draft PR delivery.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VietSory/web-codex-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/VietSory/web-codex-orchestrator/issues"
  },
  "homepage": "https://github.com/VietSory/web-codex-orchestrator#readme",
  "keywords": [
    "codex",
    "orchestration",
    "cli",
    "devtools",
    "code-review",
    "supply-chain-security"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "schemas/",
    "templates/",
    "web/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "wco": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "validate": "tsx src/cli/index.ts validate",
    "validate:template": "npm run validate -- ./templates/task-bundle",
    "lock:check": "node scripts/check-package-lock-sync.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/result-bundle/resources', 'dist/result-bundle/resources', {recursive:true, force:true})\"",
    "start": "node dist/cli/index.js",
    "wco": "node dist/cli/index.js",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "tsx --test --test-reporter=spec tests/integration/phase8-e2e.integration.ts",
    "test:cli": "tsx --test tests/integration/cli-phase6.integration.test.ts tests/integration/cli-phase7.integration.test.ts tests/integration/cli-phase8.integration.test.ts tests/integration/cli-phase9.integration.test.ts tests/integration/cli-phase10.integration.test.ts tests/integration/cli-phase11.integration.test.ts tests/integration/cli-unified.integration.test.ts",
    "test:integration": "npm run test:e2e && npm run test:cli",
    "test:native:sandbox": "tsx --test tests/integration/codex-sandbox.integration.ts",
    "test:native:codex": "tsx --test tests/integration/codex-execution.integration.ts",
    "benchmark:context": "tsx scripts/benchmark-smart-context.mts",
    "benchmark:native:context": "tsx scripts/benchmark-native-context.mts",
    "check": "npm run lock:check && npm run validate:template && npm run typecheck && npm test && npm run benchmark:context && npm run test:e2e && npm run build && npm run test:cli",
    "pack:check": "npm pack --dry-run --json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "ajv": "^8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "yazl": "3.3.1"
  },
  "dependencies": {
    "@openai/codex": "0.145.0",
    "@openai/codex-sdk": "0.145.0",
    "yauzl": "3.4.0"
  }
}

{
  "name": "web-codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Securely inspect and validate structured task bundles in isolated workflows.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wco": "./dist/cli/index.js"
  },
  "scripts": {
    "validate": "tsx src/cli/index.ts validate",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "test:codex-integration": "tsx --test tests/codex-integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "tsx": "latest",
    "typescript": "latest",
    "yazl": "3.3.1"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}

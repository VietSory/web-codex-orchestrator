{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wco:revision-request:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "spec_set_sha256",
    "previous_result_bundle_sha256",
    "previous_published_commit_sha",
    "previous_pr_head_sha",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_result_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_published_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "previous_pr_head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "classification",
          "locked_reference_ids",
          "minimal_required_fix"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^WEB-FIND-[0-9]{3,}$"
          },
          "classification": {
            "enum": [
              "SPEC_VIOLATION",
              "IMPLEMENTATION_DEFECT",
              "EVIDENCE_GAP",
              "REPOSITORY_DRIFT"
            ]
          },
          "locked_reference_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimal_required_fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    }
  }
}

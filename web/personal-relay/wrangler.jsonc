{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wco-personal-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "PersonalMailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalMailbox"] }]
}
